NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://reliefchain:reliefchain@localhost:5432/reliefchain
JWT_SECRET=replace-with-at-least-32-random-characters
PII_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
BENEFICIARY_HMAC_SECRET=replace-with-at-least-32-random-characters
MOCK_OTP=
DEMO_BENEFICIARY_PHONE=
MOCK_PAYOUT_DELAY_MS=1500
LEDGER_MODE=memory
FABRIC_CHANNEL=reliefchannel
FABRIC_CHAINCODE=relief-funds
FABRIC_MSP_ID=GovernmentMSP
FABRIC_GATEWAY_PEER=localhost:7051
FABRIC_TLS_CERT_PATH=/run/secrets/fabric_peer_tls_cert
FABRIC_CERT_PATH=/run/secrets/fabric_user_cert
FABRIC_KEY_PATH=/run/secrets/fabric_user_key
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
