NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000,http://localhost
POSTGRES_PASSWORD=reliefchain
DATABASE_URL=postgres://reliefchain:reliefchain@localhost:5432/reliefchain
JWT_SECRET=replace-with-at-least-32-random-characters
PII_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
BENEFICIARY_HMAC_SECRET=replace-with-at-least-32-random-characters
PII_ENCRYPTION_KEY_VERSION=1
BENEFICIARY_HMAC_KEY_VERSION=1
PII_ENCRYPTION_KEYS=
BENEFICIARY_HMAC_KEYS=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_DAYS=30
MOCK_OTP=123456
DEMO_BENEFICIARY_PHONE=+919876543210
MOCK_PAYOUT_DELAY_MS=1500
AUTO_SEED=true
WORKER_ENABLED=true
WORKER_MAX_ATTEMPTS=5
WORKER_BASE_RETRY_DELAY_MS=10000
WORKER_MAX_RETRY_DELAY_MS=300000
LOGIN_RATE_LIMIT=10
OTP_REQUEST_RATE_LIMIT=3
OTP_VERIFY_RATE_LIMIT=5
PROOF_RATE_LIMIT=30
AUDIT_FILTER_RATE_LIMIT=60
AUDIT_EXPORT_RATE_LIMIT=10
RETENTION_OTP_DAYS=1
RETENTION_SESSIONS_DAYS=30
RETENTION_OUTBOX_DAYS=7
LEDGER_MODE=memory
FABRIC_CHANNEL=reliefchannel
FABRIC_CHAINCODE=relief-funds
FABRIC_MSP_ID=GovernmentMSP
FABRIC_INDEXER_MSP_ID=GovernmentMSP
FABRIC_GATEWAY_PEER=localhost:7051
FABRIC_TLS_CERT_PATH=/run/secrets/fabric_peer_tls_cert
FABRIC_CERT_PATH=/run/secrets/fabric_user_cert
FABRIC_KEY_PATH=/run/secrets/fabric_user_key
FABRIC_GOVERNMENT_GATEWAY_PEER=peer0.government.example.com:7051
FABRIC_GOVERNMENT_TLS_CERT_PATH=/fabric/credentials/government/tls-ca.pem
FABRIC_GOVERNMENT_CERT_PATH=/fabric/credentials/government/cert.pem
FABRIC_GOVERNMENT_KEY_PATH=/fabric/credentials/government/key.pem
FABRIC_NGO_GATEWAY_PEER=peer0.ngo.example.com:9051
FABRIC_NGO_TLS_CERT_PATH=/fabric/credentials/ngo/tls-ca.pem
FABRIC_NGO_CERT_PATH=/fabric/credentials/ngo/cert.pem
FABRIC_NGO_KEY_PATH=/fabric/credentials/ngo/key.pem
INDEXER_RETRY_DELAY_MS=5000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
