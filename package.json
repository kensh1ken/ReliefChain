{
  "name": "reliefchain",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "fabric/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @reliefchain/api",
    "dev:web": "npm run dev -w @reliefchain/web",
    "demo:api": "node apps/demo-api/server.mjs",
    "build": "npm run build -w @reliefchain/contracts && npm run build -w @reliefchain/chaincode && npm run build -w @reliefchain/api && npm run build -w @reliefchain/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "seed": "npm run seed -w @reliefchain/api"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "d3-geo": "^3.1.1",
    "express": "^5.2.1",
    "lucide-react": "^1.35.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1"
  }
}
